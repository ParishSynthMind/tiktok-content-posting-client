# Claude (caption drafting). Leave unset and use `draft --offline` to try it with no key.
ANTHROPIC_API_KEY=

# Where the TikTok app keys and tokens live: keychain (macOS, default) or file.
TIKTOK_TOKEN_STORE=file
TIKTOK_TOKEN_FILE=.tiktok_token.json
# With the file store, the app keys come from here (TikTok for Developers > your app > App details).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must match a Redirect URI on the app's Login Kit settings exactly (TikTok requires https).
TIKTOK_REDIRECT_URI=https://parishsynthmind.github.io/tiktok-content-posting-client/callback/

# false until TikTok has audited the app: then only SELF_ONLY posts are allowed.
TIKTOK_APP_AUDITED=false

QUEUE_DIR=queue
